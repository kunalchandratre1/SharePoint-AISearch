# PUBLIC TEMPLATE ONLY
# Keep placeholder values in this file so it can be committed to GitHub.
# Copy it to .env for local use and put all real values only in .env.
# Never add passwords, client secrets, API keys, access tokens, or real
# organization-specific identifiers to this example file.

# Azure AI Search service name only, not the full URL.
AZURE_SEARCH_SERVICE=my-search-service

# SharePoint site containing the document libraries.
SHAREPOINT_SITE_URL=https://contoso.sharepoint.com/sites/MySite

# Client ID of the Entra ingestion app with Files.Read.All and Sites.Read.All.
ENTRA_APPLICATION_ID=00000000-0000-0000-0000-000000000000
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000

# Application (client) ID of the managed identity trusted by the federated
# credential. For the usual system-assigned setup, this is the application ID
# of the Azure AI Search service's managed identity.
#
# DO NOT use:
# - ENTRA_APPLICATION_ID (the SharePoint ingestion app's client ID)
# - The Azure AI Search identity's Object (principal) ID
# - The federated credential's "Subject identifier" shown in the portal
#   (that subject value is the managed identity's object/principal ID)
#
# Resolve the system-assigned identity's application ID with:
# $principalId = az search service show --name <search-service> --resource-group <resource-group> --query identity.principalId -o tsv
# az ad sp show --id $principalId --query appId -o tsv
FEDERATED_CREDENTIAL_APPLICATION_ID=00000000-0000-0000-0000-000000000000

AZURE_SEARCH_DATASOURCE_NAME=sharepoint-datasource
AZURE_SEARCH_INDEX_NAME=sharepoint-hybrid-index
AZURE_SEARCH_INDEXER_NAME=sharepoint-indexer
AZURE_SEARCH_SKILLSET_NAME=sharepoint-hybrid-skillset
AZURE_SEARCH_API_VERSION=2026-08-01-preview

# Azure OpenAI embedding deployment used for indexing and query vectorization.
# The search service managed identity needs Cognitive Services OpenAI User.
AZURE_OPENAI_ENDPOINT=https://my-openai-resource.openai.azure.com
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_MODEL=text-embedding-3-small
AZURE_OPENAI_EMBEDDING_DIMENSIONS=1536

# Text Split skill settings, in characters.
CHUNK_LENGTH=2000
CHUNK_OVERLAP=500

# Document-library modes only: defaultSiteLibrary, allSiteLibraries, or useQuery.
SP_CONTAINER_NAME=allSiteLibraries

# Required only for useQuery. Examples:
# SP_CONTAINER_QUERY=includeLibrary=https://contoso.sharepoint.com/sites/MySite/Shared Documents
# SP_CONTAINER_QUERY=includeFolder=https://contoso.sharepoint.com/sites/MySite/Shared Documents/Policies

# Remove this value to let the indexer process every supported file type.
INDEXED_FILE_EXTENSIONS=.pdf,.doc,.docx,.ppt,.pptx,.xls,.xlsx,.txt,.csv,.rtf,.html,.htm

# Optional ISO 8601 schedule. The minimum supported interval is typically PT5M.
# INDEXER_SCHEDULE_INTERVAL=PT1H

# Set only when using a user-assigned managed identity.
# USER_ASSIGNED_IDENTITY_RESOURCE_ID=/subscriptions/.../userAssignedIdentities/my-uami

# Optional: set when Azure OpenAI should use a user-assigned identity instead
# of the search service's system-assigned identity.
# AZURE_OPENAI_AUTH_IDENTITY_RESOURCE_ID=/subscriptions/.../userAssignedIdentities/my-aoai-uami

# Optional alternative for authenticating REST calls. If omitted,
# DefaultAzureCredential is used and the caller needs Search Service Contributor.
# AZURE_SEARCH_ADMIN_KEY=
